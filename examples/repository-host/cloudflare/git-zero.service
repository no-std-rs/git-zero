[Unit]
Description=Own no_std Git repository service
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=git-zero
Group=git-zero
WorkingDirectory=/opt/git-zero/examples/repository-host/cloudflare
EnvironmentFile=/etc/git-zero.env
Environment=GIT_ZERO_STATE_DIR=/var/lib/git-zero
StateDirectory=git-zero
ExecStart=/usr/bin/node /opt/git-zero/examples/repository-host/cloudflare/scripts/serve.mjs
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=30
MemoryAccounting=true
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
